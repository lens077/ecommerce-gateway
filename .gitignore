# Reference https://github.com/github/gitignore/blob/master/Go.gitignore
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Compiled Object files, Static and Dynamic libs (Shared Objects)
*.o
*.a
*.so

# OS General
Thumbs.db
.DS_Store

# project
*.cert
*.key
*.log
bin/

# Develop tools
.vscode/
.idea/
*.swp

# Temporary files in secrets directory
cmd/gateway/configs

# Configs file
# 只忽略密钥类内容（secrets/tls），config.yaml 与 policies/ 必须入库：
# 它们是 .service-matrix.yaml 对齐检查（backend/structcheck 网关接线门禁）
# 的输入，不进 Git 的话该门禁在 CI 上永远缺文件失败
configs/*
!configs/config.yaml
!configs/source.yaml.example
!configs/policies/

# Local Config Center selector; it contains the machine token.
configs/source.dev.yaml
